# Neon pooled runtime connection. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
# Direct Neon connection for migrations (optional, falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Generate each separately: openssl rand -hex 32
ADMIN_ACCESS_KEY=
AUTH_SECRET=
# Activate only after catalog, shipping, and order handling are ready.
CHECKOUT_ENABLED=false
# Flat shipping in integer IDR. Configure the actual amount before enabling orders.
SHIPPING_FLAT_RATE=
